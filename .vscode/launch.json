{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fisio: interface local",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/fisio_web.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Fisio: processar fotos (CPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/fisio_pipeline.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["Imagens", "--saida", "resultados_teste", "--device", "cpu"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
